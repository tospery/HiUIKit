OTHER_LDFLAGS = $(inherited) -framework "Accelerate" -framework "Alamofire" -framework "BonMot" -framework "CFNetwork" -framework "CoreGraphics" -framework "CoreText" -framework "DZNEmptyDataSet" -framework "DeviceKit" -framework "Differentiator" -framework "FCUUID" -framework "Foundation" -framework "HiBase" -framework "HiCore" -framework "HiJSBridge" -framework "HiLog" -framework "HiNav" -framework "HiNet" -framework "HiResource" -framework "HiTheme" -framework "HiUIKit" -framework "Kingfisher" -framework "MJRefresh" -framework "Moya" -framework "NSObject_Rx" -framework "ObjectMapper" -framework "QuartzCore" -framework "ReactorKit" -framework "RxCocoa" -framework "RxDataSources" -framework "RxOptional" -framework "RxRelay" -framework "RxSwift" -framework "RxSwiftExt" -framework "RxTheme" -framework "RxViewController" -framework "Security" -framework "SwifterSwift" -framework "TTTAttributedLabel" -framework "UICKeyChainStore" -framework "UIKit" -framework "URLNavigator_Hi" -framework "WeakMapTable" -framework "WebKit" -weak_framework "Combine" -weak_framework "SwiftUI"
