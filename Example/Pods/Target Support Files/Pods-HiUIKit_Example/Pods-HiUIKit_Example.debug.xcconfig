ALWAYS_EMBED_SWIFT_STANDARD_LIBRARIES = YES
CLANG_WARN_QUOTED_INCLUDE_IN_FRAMEWORK_HEADER = NO
FRAMEWORK_SEARCH_PATHS = $(inherited) "${PODS_CONFIGURATION_BUILD_DIR}/Alamofire" "${PODS_CONFIGURATION_BUILD_DIR}/BonMot" "${PODS_CONFIGURATION_BUILD_DIR}/DZNEmptyDataSet" "${PODS_CONFIGURATION_BUILD_DIR}/DeviceKit" "${PODS_CONFIGURATION_BUILD_DIR}/Differentiator" "${PODS_CONFIGURATION_BUILD_DIR}/FCUUID" "${PODS_CONFIGURATION_BUILD_DIR}/HiBase" "${PODS_CONFIGURATION_BUILD_DIR}/HiCore" "${PODS_CONFIGURATION_BUILD_DIR}/HiJSBridge" "${PODS_CONFIGURATION_BUILD_DIR}/HiLog" "${PODS_CONFIGURATION_BUILD_DIR}/HiNav" "${PODS_CONFIGURATION_BUILD_DIR}/HiNet" "${PODS_CONFIGURATION_BUILD_DIR}/HiResource" "${PODS_CONFIGURATION_BUILD_DIR}/HiTheme" "${PODS_CONFIGURATION_BUILD_DIR}/HiUIKit" "${PODS_CONFIGURATION_BUILD_DIR}/Kingfisher" "${PODS_CONFIGURATION_BUILD_DIR}/MJRefresh" "${PODS_CONFIGURATION_BUILD_DIR}/Moya" "${PODS_CONFIGURATION_BUILD_DIR}/NSObject+Rx" "${PODS_CONFIGURATION_BUILD_DIR}/ObjectMapper" "${PODS_CONFIGURATION_BUILD_DIR}/ReactorKit" "${PODS_CONFIGURATION_BUILD_DIR}/RxCocoa" "${PODS_CONFIGURATION_BUILD_DIR}/RxDataSources" "${PODS_CONFIGURATION_BUILD_DIR}/RxOptional" "${PODS_CONFIGURATION_BUILD_DIR}/RxRelay" "${PODS_CONFIGURATION_BUILD_DIR}/RxSwift" "${PODS_CONFIGURATION_BUILD_DIR}/RxSwiftExt" "${PODS_CONFIGURATION_BUILD_DIR}/RxTheme" "${PODS_CONFIGURATION_BUILD_DIR}/RxViewController" "${PODS_CONFIGURATION_BUILD_DIR}/SwifterSwift" "${PODS_CONFIGURATION_BUILD_DIR}/TTTAttributedLabel" "${PODS_CONFIGURATION_BUILD_DIR}/UICKeyChainStore" "${PODS_CONFIGURATION_BUILD_DIR}/URLNavigator-Hi" "${PODS_CONFIGURATION_BUILD_DIR}/WeakMapTable"
GCC_PREPROCESSOR_DEFINITIONS = $(inherited) COCOAPODS=1
HEADER_SEARCH_PATHS = $(inherited) "${PODS_CONFIGURATION_BUILD_DIR}/Alamofire/Alamofire.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/BonMot/BonMot.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/DZNEmptyDataSet/DZNEmptyDataSet.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/DeviceKit/DeviceKit.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/Differentiator/Differentiator.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/FCUUID/FCUUID.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/HiBase/HiBase.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/HiCore/HiCore.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/HiJSBridge/HiJSBridge.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/HiLog/HiLog.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/HiNav/HiNav.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/HiNet/HiNet.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/HiResource/HiResource.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/HiTheme/HiTheme.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/HiUIKit/HiUIKit.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/Kingfisher/Kingfisher.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/MJRefresh/MJRefresh.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/Moya/Moya.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/NSObject+Rx/NSObject_Rx.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/ObjectMapper/ObjectMapper.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/ReactorKit/ReactorKit.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/RxCocoa/RxCocoa.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/RxDataSources/RxDataSources.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/RxOptional/RxOptional.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/RxRelay/RxRelay.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/RxSwift/RxSwift.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/RxSwiftExt/RxSwiftExt.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/RxTheme/RxTheme.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/RxViewController/RxViewController.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/SwifterSwift/SwifterSwift.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/TTTAttributedLabel/TTTAttributedLabel.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/UICKeyChainStore/UICKeyChainStore.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/URLNavigator-Hi/URLNavigator_Hi.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/WeakMapTable/WeakMapTable.framework/Headers"
